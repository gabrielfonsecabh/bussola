# ============================================================================
# Bússola - variáveis de ambiente (modelo)
# ============================================================================
# Este arquivo é o ÚNICO que entra no git. Copie para .env.local e preencha lá.
#
#   cp .env.example .env.local
#
# Onde achar cada valor no dashboard do Supabase (projeto da Bússola):
#   Project Settings > API          -> Project URL, chave pública, service_role
#   Project Settings > General      -> Reference ID
#   Project Settings > Database     -> connection string / senha do Postgres
# ============================================================================


# ----------------------------------------------------------------------------
# 1) FRONTEND (Vite). Tudo que começa com VITE_ vai para o bundle do browser.
#    Só coloque aqui o que pode ser público. A RLS é quem protege os dados.
# ----------------------------------------------------------------------------

# Project Settings > API > Project URL
VITE_SUPABASE_URL=

# Project Settings > API > chave pública do cliente.
# Projetos novos mostram "Publishable key" (sb_publishable_...).
# Projetos antigos mostram "anon public" (um JWT longo, eyJ...).
# Qualquer uma das duas serve: cole a que aparecer no seu projeto.
VITE_SUPABASE_ANON_KEY=

# Nome exibido no shell do app (opcional).
VITE_APP_NAME=Bússola


# ----------------------------------------------------------------------------
# 2) SERVIDOR / CLI. NUNCA prefixe com VITE_ e nunca use no frontend.
#    Usado só por migrations, scripts locais e Edge Functions.
# ----------------------------------------------------------------------------

# Project Settings > General > Reference ID (ex.: abcdefghijklmnopqrst).
# Usado em: npx supabase link --project-ref $SUPABASE_PROJECT_REF
SUPABASE_PROJECT_REF=

# Project Settings > Database > senha do usuário postgres (a que você definiu
# ao criar o projeto). Usada pelo CLI no `supabase db push`.
SUPABASE_DB_PASSWORD=

# Project Settings > API > service_role (secret). Ignora TODA a RLS.
# Só existe em Edge Function ou script server-side. Se vazar, rotacione.
SUPABASE_SERVICE_ROLE_KEY=

# Token pessoal (https://supabase.com/dashboard/account/tokens).
# Usado pelos scripts db:types e pela Management API.
SUPABASE_ACCESS_TOKEN=

# Host e porta do Postgres. Os padrões abaixo valem para a região sa-east-1 e
# usam o POOLER em modo sessão (5432). O host direto db.<ref>.supabase.co só
# resolve em IPv6 e não funciona em rede IPv4.
# SUPABASE_DB_HOST=aws-0-sa-east-1.pooler.supabase.com
# SUPABASE_DB_PORT=5432


# ----------------------------------------------------------------------------
# 3) CLOUDFLARE PAGES (build de produção)
#
# No painel da Cloudflare, em Settings > Variables and Secrets, defina APENAS
# as duas de baixo, para Production e para Preview. Nenhuma das variáveis da
# seção 2 vai para lá: a service_role e o token de acesso não têm nada que
# fazer num build de frontend, e um build é lido por qualquer pessoa com acesso
# ao repositório.
#
#   VITE_SUPABASE_URL         (a mesma da seção 1)
#   VITE_SUPABASE_ANON_KEY    (a mesma da seção 1)
#
# Build command:        npm run build
# Build output:         dist         (já declarado em wrangler.toml)
# Node:                 24           (já declarado em .node-version)
#
# O build FALHA de propósito se VITE_SUPABASE_URL não estiver definida: sem ela
# o CSP sairia sem o destino do Supabase, e o site subiria bonito e incapaz de
# falar com o banco, com o erro visível só no console de quem abrisse.
# ----------------------------------------------------------------------------
